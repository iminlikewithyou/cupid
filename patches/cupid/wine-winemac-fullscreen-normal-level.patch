+/***********************************************************************
+ *              setup_fullscreen_normal_level
+ *
+ * Cupid: WINEMAC_FULLSCREEN_NORMAL_LEVEL, a list like
+ * WINEMAC_NATIVE_FULLSCREEN.  A listed program's fullscreen windows stay at
+ * the normal window level, with the menu bar and Dock hidden while one is
+ * key, instead of floating at NSStatusWindowLevel + 1 (cocoa_window.m).
+ * WINEMAC_NATIVE_FULLSCREEN wins when both list the program.
+ */
+static void setup_fullscreen_normal_level(void)
+{
+    const char *list = getenv("WINEMAC_FULLSCREEN_NORMAL_LEVEL");
+
+    while (list && *list && !native_fullscreen_allowed)
+    {
+        const char *end = strchr(list, ';');
+        size_t len = end ? (size_t)(end - list) : strlen(list);
+        if (len && len == strlen(mouselook_process) && !strncasecmp(list, mouselook_process, len))
+        {
+            fullscreen_normal_level_allowed = true;
+            TRACE("normal-level fullscreen for %s\n", debugstr_a(mouselook_process));
+            break;
+        }
+        list = end ? end + 1 : NULL;
+    }
+}
