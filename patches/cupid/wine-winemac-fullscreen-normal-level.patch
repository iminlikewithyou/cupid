+    /* Cupid: WINEMAC_FULLSCREEN_NORMAL_LEVEL.  While the key window is a
+       normal-level fullscreen window (-[WineWindow fullscreenNormalLevel]) and the
+       application is active, the menu bar and Dock auto-hide; otherwise the
+       presentation options the application had before come back. */
+    - (void) updateFullscreenPresentation
+    {
+        static BOOL applied;
+        static NSApplicationPresentationOptions saved;
+        NSWindow* key = [NSApp keyWindow];
+        BOOL want = [NSApp isActive] && [key isKindOfClass:[WineWindow class]] && [key isVisible] &&
+                    ![key isMiniaturized] && [(WineWindow*)key fullscreenNormalLevel];
+
+        /* setPresentationOptions: can re-enter this method (it activates and orders
+           windows); the state is updated before the call. */
+        if (want && !applied)
+        {
+            saved = [NSApp presentationOptions];
+            applied = TRUE;
+            @try
+            {
+                [NSApp setPresentationOptions:saved | NSApplicationPresentationAutoHideMenuBar |
+                                              NSApplicationPresentationAutoHideDock];
+            }
+            @catch (NSException* e)
+            {
+                applied = FALSE;
+                NSLog(@"winemac: could not hide the menu bar and Dock: %@", [e reason]);
+            }
+        }
+        else if (!want && applied)
+        {
+            applied = FALSE;
+            @try { [NSApp setPresentationOptions:saved]; }
+            @catch (NSException* e) { NSLog(@"winemac: could not restore the presentation options: %@", [e reason]); }
+        }
+    }
+
