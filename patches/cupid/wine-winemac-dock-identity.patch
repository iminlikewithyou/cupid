+/***********************************************************************
+ *              setup_app_identity
+ *
+ * Cupid: the name and icon the Dock shows for this process.
+ * WINEMAC_APP_NAME renames the running application through LaunchServices'
+ * private _LSSetApplicationInformationItem (as Qt and the JDK do), resolved
+ * here so that a macOS without it only loses the name.  WINEMAC_APP_ICON is
+ * an image file (.icns or .png) that replaces the icon taken from the exe.
+ * Both unset: unchanged behaviour.
+ */
+static void setup_app_identity(void)
+{
+    const char *name = getenv("WINEMAC_APP_NAME");
+    const char *icon = getenv("WINEMAC_APP_ICON");
+
+    if (icon && *icon)
+    {
+        app_icon_path = CFStringCreateWithFileSystemRepresentation(NULL, icon);
+        TRACE("Dock icon from %s\n", debugstr_a(icon));
+    }
+
+    if (name && *name)
+    {
+        void *ls = dlopen("/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/LaunchServices",
+                          RTLD_LAZY | RTLD_LOCAL);
+        CFStringRef *key;
+
+        if (!ls) ls = RTLD_DEFAULT;
+        key = dlsym(ls, "_kLSDisplayNameKey");
+        app_set_information_item = dlsym(ls, "_LSSetApplicationInformationItem");
+        app_current_asn = dlsym(ls, "_LSGetCurrentApplicationASN");
+        if (!key || !*key || !app_set_information_item || !app_current_asn)
+        {
+            TRACE("LaunchServices cannot rename the application; Dock name for %s unchanged\n", debugstr_a(name));
+            app_set_information_item = NULL;
+            app_current_asn = NULL;
+            return;
+        }
+        app_display_name_key = *key;
+        app_display_name = CFStringCreateWithCString(NULL, name, kCFStringEncodingUTF8);
+        TRACE("Dock name %s\n", debugstr_a(name));
+    }
+}
