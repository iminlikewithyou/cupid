+/* Creates the queue of the calling thread and makes it the thread's current queue. */
+static HRESULT dispatcher_queue_create_for_current_thread( BOOL dedicated, struct dispatcher_queue **out )
+{
+    static INIT_ONCE class_once = INIT_ONCE_STATIC_INIT;
+    struct dispatcher_queue *impl;
+
+    InitOnceExecuteOnce( &class_once, register_dispatcher_queue_class, NULL, NULL );
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IDispatcherQueue_iface.lpVtbl = &dispatcher_queue_vtbl;
+    impl->IDispatcherQueue2_iface.lpVtbl = &dispatcher_queue2_vtbl;
+    impl->ref = 1;
+    impl->thread_id = GetCurrentThreadId();
+    impl->dedicated = dedicated;
+    if (!(impl->hwnd = CreateWindowExW( 0, dispatcher_queue_classW, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL,
+                                        GetModuleHandleW( L"coremessaging.dll" ), NULL )))
+    {
+        DWORD err = GetLastError();
+        free( impl );
+        return HRESULT_FROM_WIN32( err );
+    }
+
+    EnterCriticalSection( &dispatcher_queues_cs );
+    list_add_head( &dispatcher_queues, &impl->entry );
+    LeaveCriticalSection( &dispatcher_queues_cs );
+
+    TRACE( "created queue %p for thread %#lx, window %p.\n", impl, impl->thread_id, impl->hwnd );
+    *out = impl;
+    return S_OK;
+}
+
+static IDispatcherQueue *dispatcher_queue_get_for_thread( DWORD thread_id )
+{
+    struct dispatcher_queue *impl;
+    IDispatcherQueue *ret = NULL;
+
+    EnterCriticalSection( &dispatcher_queues_cs );
+    LIST_FOR_EACH_ENTRY( impl, &dispatcher_queues, struct dispatcher_queue, entry )
+    {
+        if (impl->thread_id != thread_id) continue;
+        ret = &impl->IDispatcherQueue_iface;
+        IDispatcherQueue_AddRef( ret );
+        break;
+    }
+    LeaveCriticalSection( &dispatcher_queues_cs );
+    return ret;
+}
