+struct dedicated_thread_params
+{
+    HANDLE ready;
+    DISPATCHERQUEUE_THREAD_APARTMENTTYPE apartment;
+    struct dispatcher_queue *queue;
+    HRESULT hr;
+};
+
+static DWORD WINAPI dedicated_thread_proc( void *arg )
+{
+    struct dedicated_thread_params *params = arg;
+    BOOL com = FALSE;
+    MSG msg;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_coremessaging_dispatcher_queue" );
+    if (params->apartment != DQTAT_COM_NONE)
+        com = SUCCEEDED(CoInitializeEx( NULL, COINIT_APARTMENTTHREADED ));
+    /* make sure the thread has a message queue before anyone posts to it */
+    PeekMessageW( &msg, NULL, 0, 0, PM_NOREMOVE );
+    params->hr = dispatcher_queue_create_for_current_thread( TRUE, &params->queue );
+    SetEvent( params->ready );
+    if (SUCCEEDED(params->hr))
+    {
+        while (GetMessageW( &msg, NULL, 0, 0 ) > 0)
+        {
+            TranslateMessage( &msg );
+            DispatchMessageW( &msg );
+        }
+    }
+    if (com) CoUninitialize();
+    return 0;
+}
+
+static HRESULT dispatcher_queue_controller_create( DISPATCHERQUEUE_THREAD_TYPE type, DISPATCHERQUEUE_THREAD_APARTMENTTYPE apartment,
+                                                   IDispatcherQueueController **out )
+{
+    struct dispatcher_queue_controller *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IDispatcherQueueController_iface.lpVtbl = &dispatcher_queue_controller_vtbl;
+    impl->ref = 1;
+
+    if (type == DQTYPE_THREAD_CURRENT)
+        hr = dispatcher_queue_create_for_current_thread( FALSE, &impl->queue );
+    else
+    {
+        struct dedicated_thread_params params = { .apartment = apartment };
+        HANDLE thread;
+
+        params.ready = CreateEventW( NULL, TRUE, FALSE, NULL );
+        if (!(thread = CreateThread( NULL, 0, dedicated_thread_proc, &params, 0, NULL )))
+            hr = HRESULT_FROM_WIN32( GetLastError() );
+        else
+        {
+            WaitForSingleObject( params.ready, INFINITE );
+            CloseHandle( thread );
+            hr = params.hr;
+            impl->queue = params.queue;
+        }
+        CloseHandle( params.ready );
+    }
+
+    if (FAILED(hr))
+    {
+        free( impl );
+        return hr;
+    }
+
+    *out = &impl->IDispatcherQueueController_iface;
+    TRACE( "created IDispatcherQueueController %p, queue %p.\n", *out, impl->queue );
+    return S_OK;
+}
