+/***********************************************************************
+ *              setup_native_fullscreen
+ *
+ * Heartport: WINEMAC_NATIVE_FULLSCREEN is a semicolon-separated list of exe
+ * names, matched case-insensitively like WINEMAC_MOUSELOOK.  A listed
+ * program's fullscreen windows go into a macOS fullscreen Space instead of
+ * floating above every other window (cocoa_window.m).
+ */
+static void setup_native_fullscreen(void)
+{
+    const char *list = getenv("WINEMAC_NATIVE_FULLSCREEN");
+
+    while (list && *list)
+    {
+        const char *end = strchr(list, ';');
+        size_t len = end ? (size_t)(end - list) : strlen(list);
+        if (len && len == strlen(mouselook_process) && !strncasecmp(list, mouselook_process, len))
+        {
+            native_fullscreen_allowed = true;
+            TRACE("native fullscreen for %s\n", debugstr_a(mouselook_process));
+            break;
+        }
+        list = end ? end + 1 : NULL;
+    }
+}
